<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <AssemblyName>SCModUELibBridge</AssemblyName>
  </PropertyGroup>

  <!-- The Rust executables have no rpath; load the bridge from beside them. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <SharedLibraryInstallName>@executable_path/libSCModUELibBridge.dylib</SharedLibraryInstallName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Eliot.UELib" Version="1.13.7" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="Eliot.UELib" />
  </ItemGroup>

</Project>
